{
  "name": "cutting-plan",
  "version": "1.0.0",
  "description": "Steel Cutting Plan Optimization Tool",
  "main": "out/main/index.js",
  "homepage": "./",
  "author": "TFe Group",
  "scripts": {
    "dev": "node scripts/launch-dev.js",
    "build": "electron-vite build",
    "preview": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview",
    "dist": "npm run build && electron-builder",
    "start": "cross-env ELECTRON_RUN_AS_NODE= electron ."
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "konva": "^9.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.24.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "build": {
    "appId": "com.tfegroup.cuttingplan",
    "productName": "CuttingPlan",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    }
  }
}
